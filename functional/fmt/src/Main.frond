// 功能验证:std.core.fmt — 整数进制格式化(radix 2..36、小写、负号)、
// dec/hex/oct/bin 便捷函数、pad_left/pad_right 宽度填充;
// 根库引入形态(import std.core 一并带出 Fmt)由 core_module 套件锁定。
import std.core.fmt

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun main(): void {
    // ── 十进制(dec 与 parse 对偶)────────────────────────────
    check(Fmt.dec(0) == "0", "dec zero")
    check(Fmt.dec(42) == "42", "dec positive")
    check(Fmt.dec(-42) == "-42", "dec negative")
    check(Fmt.dec(-9223372036854775808 as i64) == "-9223372036854775808", "dec I64.MIN")
    check(Fmt.dec(18446744073709551615 as u64) == "18446744073709551615", "dec U64.MAX")

    // ── hex / oct / bin ──────────────────────────────────────
    check(Fmt.hex(255) == "ff", "hex lowercase")
    check(Fmt.hex(-255) == "-ff", "hex negative")
    check(Fmt.hex(3735928559 as u32) == "deadbeef", "hex deadbeef")
    check(Fmt.hex(1) == "1", "hex one")
    check(Fmt.oct(8) == "10", "oct eight")
    check(Fmt.oct(511) == "777", "oct 511")
    check(Fmt.oct(-8) == "-10", "oct negative")
    check(Fmt.bin(5) == "101", "bin five")
    check(Fmt.bin(0) == "0", "bin zero")
    check(Fmt.bin(-2) == "-10", "bin negative")

    // ── radix 2..36 全范围 ──────────────────────────────────
    check(Fmt.radix(35, 36) == "z", "radix36 digit z")
    check(Fmt.radix(1295, 36) == "zz", "radix36 zz")
    check(Fmt.radix(1270, 36) == "za", "radix36 za")
    check(Fmt.radix(10, 1) == "", "radix base 1 rejected")
    check(Fmt.radix(10, 37) == "", "radix base 37 rejected")

    // ── 泛型分发:每个整型槽位 ───────────────────────────────
    check(Fmt.hex(255 as u8) == "ff", "u8 arm")
    check(Fmt.bin(65535 as u16) == "1111111111111111", "u16 arm")
    check(Fmt.oct(4294967295 as u32) == "37777777777", "u32 arm")
    check(Fmt.hex(18446744073709551615 as u64) == "ffffffffffffffff", "u64 arm")
    check(Fmt.hex(340282366920938463463374607431768211455 as u128) == "ffffffffffffffffffffffffffffffff", "u128 arm")
    check(Fmt.dec(42 as usize) == "42", "usize arm")
    check(Fmt.hex(-1 as i8) == "-1", "i8 arm")
    check(Fmt.dec(32767 as i16) == "32767", "i16 arm")
    check(Fmt.oct(64 as i32) == "100", "i32 arm")
    check(Fmt.dec(42 as isize) == "42", "isize arm")

    // ── i128 边界(MIN 的取模走 neg_mag 半值路径)──────────
    check(Fmt.dec(170141183460469231731687303715884105727 as i128) == "170141183460469231731687303715884105727", "i128 MAX dec")
    check(Fmt.dec(-170141183460469231731687303715884105728 as i128) == "-170141183460469231731687303715884105728", "i128 MIN dec")
    check(Fmt.hex(-170141183460469231731687303715884105728 as i128) == "-80000000000000000000000000000000", "i128 MIN hex")
    check(Fmt.dec(-5 as i128) == "-5", "neg_mag odd negative")

    // ── 宽度填充 ─────────────────────────────────────────────
    check(Fmt.pad_left("ff", 4, 48) == "00ff", "pad_left zero fill")
    check(Fmt.pad_left("abcde", 3, 48) == "abcde", "pad_left no-op")
    check(Fmt.pad_left("", 2, 48) == "00", "pad_left empty")
    check(Fmt.pad_right("7", 3, 48) == "700", "pad_right fill")
    check(Fmt.pad_right("abcde", 3, 48) == "abcde", "pad_right no-op")
    check(Fmt.pad_left(Fmt.hex(255), 4, 48) == "00ff", "compose hex + pad")

    summary()
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILURES")
    }
}
