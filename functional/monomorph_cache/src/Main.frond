// 回归:单态化实例缓存键的类型哈希曾把 str 与所有复合类型(共享 ValueTag::Ref
// 的 type_id)哈希成同一个值 —— str 实例创建后,record 调用点命中 str 实例,
// `==` 被编译成 CF_EQ_STR(record 相等恒 false)。修复后按"family+名字+参数"
// 结构哈希。本套件锁定该场景及各种混合实例化顺序。
// 跨模块同名:声明解析、实例缓存键、实例体编译此前均按裸名,A.f/B.f 共享
// 一个实例并执行同一模块的函数体;修复后全程模块限定(CrossA/CrossB 用例)。
// 泛型体内的模块限定调用:实例体重推断曾回放 HM 遍历记录的类型,ModuleRef
// 携带的旧 EnvId 在临时上下文的私有 EnvArena 上越界 panic;EnvArena 现全局
// 共享于 SemaResult(std.math / std.core.hash 用例)。
import CrossA
import CrossB
import std.math
import std.core.hash

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond { println("  PASS: {name}") }
    else { failures = failures + 1; println("  FAIL: {name}") }
}
fun summary(): void {
    println("")
    if failures == 0 { println("RESULT: ALL PASSED") }
    else { println("RESULT: {failures} FAILED") }
}

type P = P(x: i64, y: i64)
type Q = Q(a: str, b: str)

fun same<T>(a: T, b: T): bool { a == b }
fun size_of<T>(v: T): i64 { 1 }

fun with_math<T>(v: T): i64 { Math.min(1, 2) as i64 + Math.abs(3) }
fun with_hash<T>(v: T): u64 { Hash.fnv1a(v) + Hash.mix_i64(7) }

fun main(): void {
    println("-- 混合实例化顺序 --")
    // str 实例在前(原始 bug 触发顺序)
    check(same("a", "a"), "str equal")
    check(!same("a", "b"), "str unequal")
    val p1 = P(1, 2)
    val p2 = P(1, 2)
    val p3 = P(1, 3)
    check(same(p1, p2), "record equal (after str instance)")
    check(!same(p1, p3), "record unequal (after str instance)")

    println("-- 标量在前 --")
    check(same(5i64, 5i64), "i64 equal")
    check(same(p1, p2), "record equal (after i64 instance)")

    println("-- 两个不同 record 类型 --")
    val q1 = Q("x", "y")
    val q2 = Q("x", "y")
    check(same(q1, q2), "second record type equal")
    check(same(p1, p2), "first record type still equal")

    println("-- 数组与嵌套 --")
    check(same([1, 2], [1, 2]), "array equal")
    check(!same([1, 2], [1, 3]), "array unequal")
    check(same("z", "z"), "str still equal at end")

    println("-- 实例缓存不串值 --")
    check(size_of(p1) == 1 && size_of("s") == 1 && size_of(7i64) == 1, "multi-instance sanity")

    println("-- 跨模块同名泛型(声明解析/缓存键/实例体编译均需模块限定)--")
    check(CrossA.f(1) == 100, "CrossA.f runs A's body")
    check(CrossB.f(1) == 200, "CrossB.f runs B's body")
    check(CrossA.f("x") == 100 && CrossB.f("x") == 200, "same-name generics per-type per-module")
    check(CrossA.f(1) == 100 && CrossB.f(1) == 200, "repeated calls stay module-correct")
    check(CrossA.g(1) == 10 && CrossB.g(1) == 20, "same-name non-generics stay module-correct")

    println("-- 泛型体内的模块限定调用(EnvArena 全局共享)--")
    check(with_math(5) == 1 + 3, "std.math calls inside a generic body")
    check(with_hash("x") == Hash.fnv1a("x") + Hash.mix_i64(7), "std.core.hash str call inside a generic body")
    val bytes_in_generic: u8[] = [200, 1, 42]
    check(with_hash(bytes_in_generic) == Hash.fnv1a(bytes_in_generic) + Hash.mix_i64(7), "byte array through nested generic + qualified call")
    check(with_math(1) == 4 && with_math("s") == 4, "generic body repeats across type args")
    summary()
}
