// 功能验证：类型转换（widening/narrowing/int-float/链式cast）
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

fun main(): void {
    println("=== Cast ===")

    // Widening: i8 → i16 → i32 → i64
    check(42i8 as i64 == 42i64, "widen i8 to i64")
    check(100i16 as i32 == 100, "widen i16 to i32")
    check(1000i32 as i64 == 1000i64, "widen i32 to i64")

    // Narrowing: wrapping
    check(300i32 as i8 == 44, "narrow i32 300 to i8 (wrap)")
    check(256i32 as u8 == 0, "narrow i32 256 to u8 (wrap)")
    check((-1i32) as u8 == 255, "narrow i32 -1 to u8 (wrap)")
    check(50000u16 as u8 == 80, "narrow u16 50000 to u8 (wrap)")

    // Int → Float
    check(42i32 as f64 == 42.0f64, "i32 to f64")
    check(0i32 as f64 == 0.0f64, "zero i32 to f64")

    // Float → Int (truncation)
    check(3.14f64 as i32 == 3, "f64 3.14 to i32 truncate")
    check(3.99f64 as i32 == 3, "f64 3.99 to i32 truncate")
    check((-2.7f64) as i32 == -2, "f64 -2.7 to i32 truncate")

    // 链式 cast
    check((100i32 as i64) as i8 == 100, "chained i32->i64->i8")

    // cast 在算术中
    val a: i32 = 100
    val b: i64 = a as i64 * 2i64
    check(b == 200i64, "cast in arithmetic")

    // signed <-> unsigned
    val neg: i8 = -1
    check(neg as u8 == 255, "i8 -1 to u8")
    check(neg as i64 == -1i64, "i8 -1 to i64 (sign extend)")

    // widening u8 -> u16 -> u32
    val u8v: u8 = 200
    check(u8v as u16 == 200, "u8 to u16")
    check(u8v as u32 == 200, "u8 to u32")

    // narrowing i64 -> i16 (in range)
    val big: i64 = 1000
    check(big as i16 == 1000, "i64 to i16 in range")

    // char <-> int
    val c: char = 'A'
    check(c as i32 == 65, "char A to i32")

    // int -> str
    check(42i32 as str == "42", "i32 to str")
    check(0i32 as str == "0", "zero to str")

    // float -> str
    check(true as str == "true", "bool true to str")
    check(false as str == "false", "bool false to str")

    // 嵌套泛型 cast：(x as f64) as T
    check(double_cast(3.14) == 3.14, "nested cast f64 roundtrip")
    check(double_cast(42) == 42, "nested cast i32 roundtrip")

    // ─── Cast 边缘测试 ───

    // cast 边界值
    check(127i8 as i32 == 127, "i8 MAX to i32")
    check((-128i8) as i32 == -128, "i8 MIN to i32")
    check(255u8 as i32 == 255, "u8 MAX to i32")

    // cast 0 值
    check(0i32 as f64 == 0.0f64, "zero i32 to f64")
    check(0i64 as f64 == 0.0f64, "zero i64 to f64")

    // cast 负数到无符号
    check((-1i32) as u8 == 255, "i32 -1 to u8")
    check((-1i64) as u8 == 255, "i64 -1 to u8")

    // cast f64 边界
    check(0.0f64 as i32 == 0, "f64 0.0 to i32")
    check((-0.0f64) as i32 == 0, "f64 -0.0 to i32")

    // 链式 cast（3 层）
    check(((65i32 as i64) as i8) as i32 == 65, "3-layer chain cast")

    // cast 在表达式中
    val mixed: i64 = 100i32 as i64 + 200i32 as i64
    check(mixed == 300, "cast in expression sum")

    // cast bool -> str（已在上文测试）
    // bool -> int 不支持，跳过

    // cast char 边界
    check('A' as i32 == 65, "char A to i32")
    check('a' as i32 == 97, "char a to i32")
    check('0' as i32 == 48, "char 0 to i32")

    // cast i32 -> char
    check(65i32 as char == 'A', "i32 65 to char A")

    // cast 负数 f64 -> i32
    check((-3.7f64) as i32 == -3, "f64 -3.7 to i32 truncate")
    check((-0.5f64) as i32 == 0, "f64 -0.5 to i32 truncate")

    // cast 大整数 narrowing
    check(32767i32 as i16 == 32767, "i32 MAX i16 to i16 (in range)")
    check(32768i32 as i16 == -32768, "i32 32768 to i16 (wrap to MIN)")

    // cast u8 -> i8 (高位变符号)
    check(200u8 as i8 == -56, "u8 200 to i8 (sign bit)")
    check(127u8 as i8 == 127, "u8 127 to i8 (in range)")

    // cast 在函数参数中
    fun takesI64(x: i64): i64 { x }
    check(takesI64(42i32 as i64) == 42i64, "cast in function argument")

    // ─── 大胆 cast 边缘 ───

    // i128 宽化与窄化
    check(42i32 as i128 == 42i128, "i32 to i128 widen")
    check((-1i32) as i128 == -1i128, "i32 -1 to i128 sign extend")
    check(127i8 as i128 == 127i128, "i8 MAX to i128")
    check((-128i8) as i128 == -128i128, "i8 MIN to i128 sign extend")
    // i64 → i128 符号扩展
    check((-1i64) as i128 == -1i128, "i64 -1 to i128 sign extend")
    check(9223372036854775807i64 as i128 == 9223372036854775807i128, "i64 MAX to i128")

    // u128（通过 -1i128 as u128 构造 MAX，绕过 Bug #25）
    val u128_max: u128 = (-1i128) as u128
    check(255u8 as u128 == 255u128, "u8 255 to u128 zero extend")
    check(0u8 as u128 == 0u128, "u8 0 to u128")
    check(u128_max as i128 == -1i128, "u128 MAX to i128 = -1 (bit reinterpret)")

    // 符号扩展 vs 零扩展对照
    val neg_byte: i8 = -1
    check(neg_byte as i64 == -1i64, "i8 -1 sign extend to i64 = -1")
    check((neg_byte as u8) as i64 == 255i64, "i8 -1 -> u8 -> i64 zero extend = 255")
    val pos_u8: u8 = 200
    check(pos_u8 as u64 == 200u64, "u8 200 zero extend to u64 = 200")
    check((pos_u8 as i8) as i64 == -56i64, "u8 200 -> i8 -> i64 sign extend = -56")

    // f16 ↔ f32 ↔ f64 链式
    check(1.5f64 as f32 == 1.5f32, "f64 1.5 to f32")
    check(1.5f32 as f64 == 1.5f64, "f32 1.5 to f64")
    check(1.5f64 as f16 == 1.5f16, "f64 1.5 to f16")
    check(1.5f16 as f64 == 1.5f64, "f16 1.5 to f64")
    check((3.14f64 as f16) as f64 != 3.14f64, "f64 -> f16 -> f64 loses precision")

    // f128 链式
    check(1.0f64 as f128 == 1.0f128, "f64 1.0 to f128")
    check(1.0f128 as f64 == 1.0f64, "f128 1.0 to f64")

    // char 大码点 roundtrip
    check('你' as i32 == 20320, "char 你 to i32 = 20320")
    check(20320i32 as char == '你', "i32 20320 to char 你")
    check('€' as i64 == 8364i64, "char € to i64 = 8364")
    check(8364i64 as char == '€', "i64 8364 to char €")

    // i32 → f64 → i32 大值往返
    check((1000000i32 as f64) as i32 == 1000000, "i32 1M -> f64 -> i32 exact")
    check(((-1000000i32) as f64) as i32 == -1000000, "i32 -1M -> f64 -> i32 exact")

    // cast 在 match 表达式中
    val n: i32 = 5
    val as_f64 = match n {
        0 => 0.0f64
        _ => n as f64
    }
    check(as_f64 == 5.0f64, "cast in match arm")

    // cast i64 → i32 窄化溢出（wrapping）
    check(4294967296i64 as i32 == 0, "i64 2^32 to i32 wraps to 0")
    check(4294967297i64 as i32 == 1, "i64 2^32+1 to i32 wraps to 1")
    check((-4294967296i64) as i32 == 0, "i64 -2^32 to i32 wraps to 0")

    // cast 嵌套在算术表达式
    check(10i32 as i64 * 20i32 as i64 + 5i32 as i64 == 205i64, "nested cast arithmetic")

    summary()
}

// 嵌套泛型 cast：(x as f64) as T
fun double_cast<T>(x: T): T {
    (x as f64) as T
}
