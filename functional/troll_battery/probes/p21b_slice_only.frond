// p21b_slice_only.frond — 切片操作专项测试（不含 array fill）
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

pub fun main(): void {
    println("=== Slice ===")
    val data = [10i32, 20, 30, 40, 50]

    val s1 = data[1..3]
    check(s1.len() == 2, "slice exclusive: len")
    check(s1[0] == 20, "slice exclusive: elem 0")
    check(s1[1] == 30, "slice exclusive: elem 1")

    val s2 = data[1..=3]
    check(s2.len() == 3, "slice inclusive: len")
    check(s2[2] == 40, "slice inclusive: elem 2")

    val full = data[0..5]
    check(full.len() == 5, "slice full: len")

    val empty = data[2..2]
    check(empty.len() == 0, "slice empty: len 0")

    val single = data[2..3]
    check(single.len() == 1, "slice single: len 1")
    check(single[0] == 30, "slice single: elem 0")

    val nested = data[0..4][1..3]
    check(nested.len() == 2, "nested slice: len")
    check(nested[0] == 20, "nested slice: elem 0")

    println("--- String Slice ---")
    val s = "Hello World"
    val sub = s[0..5]
    check(sub == "Hello", "str slice exclusive")
    val sub2 = s[6..=10]
    check(sub2 == "World", "str slice inclusive")
    val sub3 = s[0..0]
    check(sub3 == "", "str slice empty")

    summary()
}
