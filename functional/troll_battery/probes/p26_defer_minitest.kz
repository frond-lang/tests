// p26_defer_minitest.kz — defer 赋值最小化测试
var g: i32 = 0
var s: str = ""

pub fun main(): void {
    println("=== Defer Assign Mini Test ===")

    // Test 1: single defer with simple literal assign to global
    g = 0
    fun t1(): void {
        defer g = 42
        g = 10
    }
    t1()
    println("t1: g={g} (expect 42)")

    // Test 2: multiple defers LIFO with literal assign
    g = 0
    fun t2(): void {
        defer g = 1
        defer g = 2
        defer g = 3
        g = 99
    }
    t2()
    println("t2: g={g} (expect 1, LIFO: 99->3->2->1)")

    // Test 3: defer with expression (read+write global)
    s = ""
    fun t3(): void {
        defer s = s + "A"
        s = s + "body"
    }
    t3()
    println("t3: s='{s}' (expect 'bodyA')")

    // Test 4: multiple defer with expression
    s = ""
    fun t4(): void {
        defer s = s + "A"
        defer s = s + "B"
        s = s + "body"
    }
    t4()
    println("t4: s='{s}' (expect 'bodyBA')")

    // Test 5: defer field assign
    type Box = Box(v: i32)
    var b = Box(0)
    fun t5(): void {
        defer b.v = 77
        b.v = 10
    }
    t5()
    println("t5: b.v={b.v} (expect 77)")

    // Test 6: defer simple val assign (local)
    fun t6(): i32 {
        var y: i32 = 0
        defer y = 42
        y
    }
    val r6 = t6()
    println("t6: r6={r6} (expect 0, defer after return)")

    // Test 7: 3 defers with string expression (like p25)
    s = ""
    fun t7(): void {
        defer s = s + "A"
        defer s = s + "B"
        defer s = s + "C"
        s = s + "body|"
    }
    t7()
    println("t7: s='{s}' (expect 'body|CBA')")

    // Test 8: defer field assign with &this method
    type Box2 = Box2(v: i32) {
        pub fun &set_deferred(): void {
            defer this.v = 88
            this.v = 11
        }
    }
    var b2 = Box2(0)
    b2.set_deferred()
    println("t8: b2.v={b2.v} (expect 88)")
}
