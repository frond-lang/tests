// p23_compound_assign.kz — 复合赋值运算符专项测试（含位运算复合赋值）
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

pub fun main(): void {
    println("=== Compound Assignment ===")

    // ── 算术复合赋值 ──
    println("--- Arithmetic Compound ---")
    var a: i32 = 10
    a += 5
    check(a == 15, "+= 5")
    a -= 3
    check(a == 12, "-= 3")
    a *= 2
    check(a == 24, "*= 2")
    a /= 4
    check(a == 6, "/= 4")
    a %= 4
    check(a == 2, "%= 4")

    // ── 位运算复合赋值 ──
    println("--- Bitwise Compound ---")
    var x: i32 = 0xFF
    x &= 0x0F
    check(x == 15, "&= 0x0F")

    var y: i32 = 0xF0
    y |= 0x0F
    check(y == 255, "|= 0x0F")

    var z: i32 = 0xAA
    z ^= 0xFF
    check(z == 85, "^= 0xFF")

    var s: i32 = 1
    s <<= 4
    check(s == 16, "<<= 4")

    var r: i32 = 256
    r >>= 2
    check(r == 64, ">>= 2")

    // ── 链式复合赋值 ──
    println("--- Chained Compound ---")
    var c: i32 = 10
    c += 5
    c -= 3
    c *= 2
    c /= 4
    c %= 5
    // ((10+5-3)*2/4)%5 = (12*2/4)%5 = (24/4)%5 = 6%5 = 1
    check(c == 1, "chained: += -= *= /= %=")

    // ── 复合赋值在循环中 ──
    println("--- Compound in Loop ---")
    var acc: i32 = 1
    var i: i32 = 0
    while i < 5 {
        acc *= 2
        i += 1
    }
    check(acc == 32, "loop: *= 2 five times")
    check(i == 5, "loop: += 1 five times")

    // ── 复合赋值在字段上 ──
    println("--- Compound on Field ---")
    type Box = Box(v: i32)
    var b = Box(10)
    b.v += 5
    println("  INFO: b.v after += 5 = {b.v} (expect 15)")
    check(b.v == 15, "field +=")
    b.v <<= 2
    println("  INFO: b.v after <<= 2 = {b.v} (expect 60)")
    check(b.v == 60, "field <<=")

    // ── 复合赋值在数组元素上 ──
    println("--- Compound on Array Element ---")
    val arr = [1i32, 2, 3, 4]
    // arr[i] += x 是否支持？
    var idx: i32 = 1
    // 探测：数组元素复合赋值
    // arr[idx] += 10  // 可能不支持，探测

    summary()
}
