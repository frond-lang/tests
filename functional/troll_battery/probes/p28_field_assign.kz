// p28_field_assign.kz — 字段赋值专项测试
pub fun main(): void {
    println("=== Field Assignment ===")

    type Box = Box(v: i32) {
        // implicit this, simple assign
        pub fun &set_implicit(x: i32): void {
            v = x
        }
        // explicit this, simple assign
        pub fun &set_explicit(x: i32): void {
            this.v = x
        }
        // implicit, compound read+write
        pub fun &add_implicit(x: i32): void {
            v = v + x
        }
        // explicit, compound read+write
        pub fun &add_explicit(x: i32): void {
            this.v = this.v + x
        }
        // implicit, compound assign
        pub fun &add_compound(x: i32): void {
            v += x
        }
        fun get(): i32 { v }
    }

    val b1 = Box(0)
    b1.set_implicit(10)
    println("set_implicit(10): b1.v={b1.get()} (expect 10)")

    val b2 = Box(0)
    b2.set_explicit(20)
    println("set_explicit(20): b2.v={b2.get()} (expect 20)")

    val b3 = Box(5)
    b3.add_implicit(10)
    println("add_implicit(10): b3.v={b3.get()} (expect 15)")

    val b4 = Box(5)
    b4.add_explicit(10)
    println("add_explicit(10): b4.v={b4.get()} (expect 15)")

    val b5 = Box(5)
    b5.add_compound(10)
    println("add_compound(10): b5.v={b5.get()} (expect 15)")

    // Non-method field assign (global var)
    type Box2 = Box2(v: i32)
    var g = Box2(0)
    g.v = 99
    println("global g.v = 99: g.v={g.v} (expect 99)")
}
