// p31_misc_features.frond — 杂项特性测试：escape sequences, neg literal boundary, as cast, sci notation
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

pub fun main(): void {
    println("=== Misc Features ===")

    // ── 字符串转义序列 ──
    println("--- Escape Sequences ---")
    val tab = "a\tb"
    check(tab == "a	b", "escape: tab")
    val nl = "a\nb"
    check(nl == "a\nb", "escape: newline")
    val quote = "a\"b"
    check(quote == "a\"b", "escape: quote")
    val slash = "a\\b"
    check(slash == "a\\b", "escape: backslash")

    // Unicode 转义
    val u1 = "\u0041"
    check(u1 == "A", "escape: \\u0041 = A")
    val u2 = "\u{4E2D}"
    check(u2 == "中", "escape: \\u{4E2D} = 中")
    val u3 = "\u{1F600}"
    check(u3.len() > 0, "escape: \\u{1F600} emoji non-empty")

    // ── 负字面量边界（MIN 值）──
    println("--- Negative Literal Boundary ---")
    val i8_min: i8 = -128i8
    check(i8_min == -128i8, "i8 MIN = -128")
    val i16_min: i16 = -32768i16
    check(i16_min == -32768i16, "i16 MIN = -32768")
    val i32_min: i32 = -2147483648i32
    check(i32_min == -2147483648i32, "i32 MIN = -2147483648")
    val i64_min: i64 = -9223372036854775808i64
    check(i64_min == -9223372036854775808i64, "i64 MIN")

    // MIN 值 wrapping 运算
    val wrap_sub = i32_min - 1
    check(wrap_sub == 2147483647, "i32 MIN - 1 wraps to MAX")
    val wrap_neg = -i32_min
    check(wrap_neg == -2147483648i32, "neg i32 MIN wraps (stays MIN)")

    // 负十六进制 — 探测：-0xFF 是否支持
    // 注：parser 将 -0xFF 视为无效字面量，改用变量
    val hex_val = 0xFFi32
    val neg_hex = -hex_val
    check(neg_hex == -255, "negative hex (via variable)")

    // ── 科学计数法极端值 ──
    println("--- Sci Notation Extreme ---")
    val tiny = 1e-300f64
    check(tiny > 0.0f64, "1e-300 > 0")
    val maxd = 1.7976931348623157e308f64
    check(maxd > 1e307f64, "max f64")
    val overflow = 1e309f64
    check(overflow == overflow / 2.0f64, "1e309 = inf (inf == inf/2)")
    val f32val = 1.5e10f32
    check(f32val > 1e9f32, "1.5e10f32")

    // ── as cast ──
    println("--- as cast ---")
    val big: i64 = 99999999999i64
    val truncated = big as i32
    check(truncated == big as i32, "cast i64->i32 deterministic")

    summary()
}
