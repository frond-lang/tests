// p37_p2_batch2.kz — P2 探测：trait 继承、关联类型、闭包捕获、字符串模板、浮点边缘
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

// ── trait 定义 ──
trait Show {
    fun show(): str
}

type Shape: Show = | Circle(f64) | Square(f64) {
    fun show(): str {
        match this {
            Circle(r) => "Circle({r})"
            Square(s) => "Square({s})"
        }
    }
}

// 多 trait 组合
trait Named {
    fun named(): str
}

type Triple: (Named, Show) = | A | B | C {
    fun named(): str {
        match this {
            A => "alpha"
            B => "beta"
            C => "gamma"
        }
    }
    fun show(): str {
        named()
    }
}

// ── 带方法的 record ──
type Counter = Counter(v: i32) {
    fun inc(): void {
        this.v = this.v + 1
    }
    fun get(): i32 {
        this.v
    }
}

pub fun main(): void {
    println("=== P2 Batch 2 ===")

    // ── trait 组合 ──
    println("--- Trait Composition ---")
    val s = Circle(3.0)
    val shown = s.show()
    println("  INFO: Circle(3.0).show() = '{shown}'")
    check(shown == "Circle(3)" || shown == "Circle(3.0)", "trait: show on Shape")

    // 多 trait 组合
    val t: Triple = A
    check(t.named() == "alpha", "trait: named on Triple")
    check(t.show() == "alpha", "trait: show via composition")

    // ── 带方法的 record ──
    println("--- Record Methods ---")
    val c = Counter(0)
    c.inc()
    c.inc()
    c.inc()
    check(c.get() == 3, "record method: inc 3 times")

    // ── 闭包捕获 ──
    println("--- Closure Capture ---")
    var captured = 10i32
    val adder = fun(x: i32) { captured + x }
    check(adder(5) == 15, "closure: capture var")

    val setter = fun(v: i32) { captured = v }
    setter(99)
    check(captured == 99, "closure: modify captured var")

    fun make_adder(base: i32): (i32) -> i32 {
        fun(x: i32) { base + x }
    }
    val add10 = make_adder(10)
    check(add10(5) == 15, "closure: returned from function")

    // ── 字符串模板边缘 ──
    println("--- String Interpolation Edges ---")
    val n = 42i32
    check("{n}" == "42", "interp: simple int")

    check("val={n}" == "val=42", "interp: prefix")

    check("{n}!" == "42!", "interp: suffix")

    check("a{n}b{n}c" == "a42b42c", "interp: multiple")

    // 表达式插值
    val x = 3i32
    val y = 4i32
    check("{x + y}" == "7", "interp: expression")

    // ── 浮点边缘 ──
    println("--- Float Edges ---")
    val pi = 3.14159265358979
    check(pi > 3.14 && pi < 3.15, "float: pi precision")

    val f32_val = 1.5f32
    val f64_val = 1.5
    check(f32_val == 1.5f32, "float: f32 literal")
    check(f64_val == 1.5, "float: f64 literal")

    // ── 空数组和单元素数组 ──
    println("--- Array Edges ---")
    val empty: i32[] = []
    check(empty.len() == 0, "array: empty len 0")

    val single = [42i32]
    check(single.len() == 1, "array: single element")
    check(single[0] == 42, "array: single access")

    // ── 深层嵌套表达式 ──
    println("--- Deep Nesting ---")
    val deep = ((1i32 + 2) * 3 - 4) / 5 + 6
    check(deep == 7, "deep: ((1+2)*3-4)/5+6 = 7")

    val sign = if -5i32 < 0 { -1i32 } else { 1i32 }
    check(sign == -1, "if expr: negative")

    // ── 字符串拼接 ──
    println("--- String Concat ---")
    val parts = ["Hello", " ", "World"]
    var combined = ""
    for p in parts.iter() {
        combined = combined + p
    }
    check(combined == "Hello World", "str concat: loop build")

    check("ab" + "cd" == "abcd", "str: + concat")

    summary()
}
