// defer 在 throw 时执行
var log: str = ""

fun throwing(): Throw<void, Error> {
    log = log + "start "
    defer log = log + "defer "
    log = log + "before-throw "
    throw Error("boom")
}

fun main(): void {
    val r = throwing()
    match r {
        Ok(_) => println("ok")
        Err(e) => println("err")
    }
    println("log={log}")
}
