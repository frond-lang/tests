// p27_defer_capture.kz — defer 捕获局部变量 vs 全局变量
var g_s: str = ""

pub fun main(): void {
    println("=== Defer Capture Scope ===")

    // Test A: defer on global string — should work
    g_s = ""
    fun tA(): void {
        defer g_s = g_s + "A"
        g_s = g_s + "body"
    }
    tA()
    println("tA (global): g_s='{g_s}' (expect 'bodyA')")

    // Test B: defer on local string (not captured by nested fn)
    var local_s: str = ""
    fun tB(): void {
        defer local_s = local_s + "A"
        local_s = local_s + "body"
    }
    tB()
    println("tB (local captured): local_s='{local_s}' (expect 'bodyA')")

    // Test C: defer on local int
    var local_i: i32 = 0
    fun tC(): void {
        defer local_i = 42
        local_i = 10
    }
    tC()
    println("tC (local int): local_i={local_i} (expect 42)")

    // Test D: defer on local string, 3 defers
    var s3: str = ""
    fun tD(): void {
        defer s3 = s3 + "A"
        defer s3 = s3 + "B"
        defer s3 = s3 + "C"
        s3 = s3 + "body|"
    }
    tD()
    println("tD (local 3 defers): s3='{s3}' (expect 'body|CBA')")

    // Test E: defer field assign via this (explicit)
    type Box = Box(v: i32) {
        pub fun &setv(x: i32): void {
            this.v = x
        }
        pub fun &defer_setv(x: i32): void {
            defer this.v = x
            this.v = 0
        }
    }
    var b = Box(0)
    b.setv(55)
    println("tE1 (this.v = 55): b.v={b.v} (expect 55)")
    b.defer_setv(77)
    println("tE2 (defer this.v = 77): b.v={b.v} (expect 77)")

    // Test F: defer field assign via implicit this
    type Box2 = Box2(v: i32) {
        pub fun &defer_implicit(x: i32): void {
            defer v = x
            v = 0
        }
    }
    var b2 = Box2(0)
    b2.defer_implicit(99)
    println("tF (defer v = 99 implicit): b2.v={b2.v} (expect 99)")
}
