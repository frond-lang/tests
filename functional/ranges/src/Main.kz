// 功能验证：range 运算符 a..b / a..=b（回归：Bug #92）
// Bug #92: sema 曾要求操作数隐式 widen 到 i64，而 Bug #60 已删除隐式提升，
// 导致 `0..5` 从未可用（"range operand must be integer"）。修复后任意整数类型
// 操作数可用，IR 侧显式 widen 到 i64（RangeIterator 是 i64 迭代器，循环变量是 i64）。
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond { println("  PASS: {name}") }
    else { failures = failures + 1; println("  FAIL: {name}") }
}
fun summary(): void {
    println("")
    if failures == 0 { println("RESULT: ALL PASSED") }
    else { println("RESULT: {failures} FAILED") }
}

fun sumExclusive(): i64 {
    var s: i64 = 0
    for i in 0..5 { s = s + i }
    s
}
fun sumInclusive(): i64 {
    var s: i64 = 0
    for i in 0..=5 { s = s + i }
    s
}
fun i32VarsRange(): i64 {
    val a: i32 = 1
    val b: i32 = 4
    var s: i64 = 0
    for i in a..b { s = s + i }
    s
}
fun u8Range(): i64 {
    var s: i64 = 0
    for i in 0u8..4u8 { s = s + i }
    s
}
fun emptyRange(): i64 {
    var s: i64 = 0
    for i in 5..0 { s = s + 1 }
    s
}
fun singleRange(): i64 {
    var s: i64 = 0
    for i in 3..3 { s = s + 1 }
    s
}
fun singleInclusive(): i64 {
    var s: i64 = 0
    for i in 3..=3 { s = s + 1 }
    s
}
fun rangeWithBreak(): i64 {
    var s: i64 = 0
    for i in 0..100 {
        if i == 5i64 { break }
        s = s + i
    }
    s
}
fun rangeWithContinue(): i64 {
    var s: i64 = 0
    for i in 0..6 {
        if i % 2i64 == 0i64 { continue }
        s = s + i
    }
    s
}
fun rangeNested(): i64 {
    var n: i64 = 0
    for i in 0..3 {
        for j in 0..3 {
            if j == 2i64 { break }
            n = n + 1
        }
    }
    n
}
fun rangeLoopVarArith(): i64 {
    var squares: i64 = 0
    for i in 1..4 { squares = squares + i * i }
    squares
}
fun strIterFor(): str {
    var s: str = ""
    for c in "abc".iter() { s = s + c as str }
    s
}

fun main(): void {
    check(sumExclusive() == 10, "0..5 exclusive sum 10")
    check(sumInclusive() == 15, "0..=5 inclusive sum 15")
    check(i32VarsRange() == 6, "i32 var operands 1..4")
    check(u8Range() == 6, "u8 operands 0..4")
    check(emptyRange() == 0, "empty range 5..0 no iterations")
    check(singleRange() == 0, "3..3 exclusive empty")
    check(singleInclusive() == 1, "3..=3 single iteration")
    check(rangeWithBreak() == 10, "break at 5")
    check(rangeWithContinue() == 9, "continue skips evens 1+3+5")
    check(rangeNested() == 6, "nested with inner break")
    check(rangeLoopVarArith() == 14, "loop var arithmetic 1+4+9")
    check(strIterFor() == "abc", "str .iter() for-in")
    summary()
}
