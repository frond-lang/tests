// 功能验证：std.io.Fs 管理面（exists / copy_file / chmod / stat_of / Dir.list）
// 全部走 async io 域风格 + Throw 一等值断言。
import std.io.Fs
import std.io.File
import std.io.Dir
import std.io.File.{remove as delete_file}

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun check_err(result: Throw<void, IOError>, name: str): void {
    match result {
        Ok(_) => check(true, name),
        Err(e) => check(false, "{name} ({e.msg})"),
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

fun exists_checks(): void {
    println("-- exists --")
    val yes = match Fs.exists("src/Main.kz").await() {
        Ok(v) => v,
        Err(e) => { check(false, "exists source ({e.msg})"); return }
    }
    check(yes, "exists: source file")

    val no = match Fs.exists("definitely_missing_frond_xyz.kz").await() {
        Ok(v) => v,
        Err(e) => { check(false, "exists missing ({e.msg})"); return }
    }
    check(no == false, "exists: missing file -> false")

    val dir_yes = match Fs.exists(".").await() {
        Ok(v) => v,
        Err(_) => false,
    }
    check(dir_yes, "exists: directory")
}

fun copy_checks(): void {
    println("-- copy_file --")
    // 准备源文件
    match Fs.write_file("fs_test_src.txt", "copy-me").await() {
        Ok(_) => {},
        Err(e) => { check(false, "copy: write source ({e.msg})"); return }
    }

    check_err(Fs.copy_file("fs_test_src.txt", "fs_test_dst.txt").await(), "copy_file basic")

    // NOTE: `match` on an awaited Throw with an early-return Err arm trips an
    // engine match-dispatch bug (tracked); the `?` form is verified working.
    val back = Fs.read_file("fs_test_dst.txt").await()?
    check(back == "copy-me", "copy_file content identical")

    // 覆盖语义：先改目标内容，再 copy 覆盖
    val _ = Fs.write_file("fs_test_dst.txt", "stale").await()
    check_err(Fs.copy_file("fs_test_src.txt", "fs_test_dst.txt").await(), "copy_file overwrite")
    val back2 = Fs.read_file("fs_test_dst.txt").await()?
    check(back2 == "copy-me", "copy_file overwrite content")

    // 大小一致性（经 stat）
    val st = File.stat_of("fs_test_dst.txt").await()?
    check(st.size == 7u64, "copy_file size matches ({st.size})")

    // 复制不存在文件 -> Err
    match Fs.copy_file("definitely_missing_frond_xyz.kz", "fs_test_dst.txt").await() {
        Ok(_) => check(false, "copy missing should fail"),
        Err(_) => check(true, "copy_file missing source -> Err"),
    }
    // File.remove is the semantic cleanup path (the name-clash incident's
    // original symptom: this call used to silently bind Env.remove and
    // delete nothing).
    File.remove("fs_test_src.txt").await()?
    File.remove("fs_test_dst.txt").await()?
}

fun chmod_checks(): void {
    println("-- chmod --")
    Fs.write_file("fs_test_mode.txt", "x").await()?
    Fs.chmod("fs_test_mode.txt", 0o444).await()?
    Fs.chmod("fs_test_mode.txt", 0o644).await()?
    check(true, "chmod roundtrip (inline)")
    // File.chmod and Fs.chmod are same-named functions in different modules:
    // both must compile and both must reach their own body.
    match File.chmod("fs_test_mode.txt", 0o444).await() {
        Ok(_) => check(true, "File.chmod roundtrip"),
        Err(e) => check(false, "File.chmod roundtrip ({e.msg})"),
    }
    File.chmod("fs_test_mode.txt", 0o644).await()?
    check_err(Fs.write_file("fs_test_mode.txt", "y").await(), "writable after restore")
    File.remove("fs_test_mode.txt").await()?
}

// Side-effect assertions: effectful APIs must be verified by the WORLD-STATE
// diff (file really gone / really moved), never by Ok/Err alone — Ok was
// exactly how the wrong-callee bug stayed invisible for months.

// World-state probe via the public API (raw @internal primitives are no
// longer callable outside stdlib): Err counts as "missing".
fun fs_path_exists(path: str): bool {
    match Fs.exists(path).await() {
        Ok(b) => b,
        Err(_) => false,
    }
}

fun remove_rename_checks(): void {
    println("-- remove / rename side effects --")
    Fs.write_file("fs_rm.txt", "x").await()?
    val r = File.remove("fs_rm.txt").await()
    match r {
        Ok(_) => {
            check(fs_path_exists("fs_rm.txt") == false, "File.remove: file actually deleted")
        },
        Err(e) => check(false, "File.remove returned Err ({e.msg})"),
    }

    Fs.write_file("fs_mv_src.txt", "payload").await()?
    match File.rename("fs_mv_src.txt", "fs_mv_dst.txt").await() {
        Ok(_) => {
            check(fs_path_exists("fs_mv_src.txt") == false, "File.rename: source actually gone")
            check(fs_path_exists("fs_mv_dst.txt") == true, "File.rename: destination actually exists")
        },
        Err(e) => check(false, "File.rename returned Err ({e.msg})"),
    }
    File.remove("fs_mv_dst.txt").await()?

    // Selective import alias: `delete_file` must bind std.io.File.remove
    // (the IR-side alias plumbing) and delete the file.
    Fs.write_file("fs_alias.txt", "x").await()?
    match delete_file("fs_alias.txt").await() {
        Ok(_) => check(fs_path_exists("fs_alias.txt") == false, "import alias: File.remove actually deleted"),
        Err(e) => check(false, "import alias remove returned Err ({e.msg})"),
    }
}

fun dir_checks(): void {
    println("-- Dir.list --")
    val entries = Dir.list(".").await()?
    check(entries.len() > 0, "Dir.list non-empty")
    var found_src = false
    for e in entries.iter() {
        if e.name == "frond.toml" && e.kind == FileKind.File { found_src = true }
    }
    check(found_src, "Dir.list finds frond.toml (File kind)")
}

fun main(): void {
    println("=== std.io.Fs management ===")
    exists_checks()
    copy_checks()
    chmod_checks()
    remove_rename_checks()
    dir_checks()
    summary()
}
