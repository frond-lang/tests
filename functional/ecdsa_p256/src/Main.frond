// ecdsa_p256 - ECDSA P-256 verification kernel acceptance.
// Vectors generated with the Python cryptography library (fresh random
// keys, real signatures over random messages); every other case is the
// same signature with a tampered digest, which must fail closed.
import std.crypto.EcdsaP256

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun hex_bytes(s: str): u8[] {
    match std.encoding.Hex.decode(s) {
        null => [],
        b => b,
    }
}

fun run_case(idx: i32, pub_hex: str, hash_hex: str, rs_hex: str, expect: bool): void {
    val pk = hex_bytes(pub_hex)
    val h = hex_bytes(hash_hex)
    val rs = hex_bytes(rs_hex)
    val got = match EcdsaP256.verify(pk, h, rs) {
        Ok(v) => v,
        Error(e) => { println("  error: {e.message}"); false },
    }
    if got == expect {
        println("  PASS: vector {idx} (expect {expect})")
    } else {
        failures = failures + 1
        println("  FAIL: vector {idx} (expected {expect}, got {got})")
    }
}

fun main(): void {
    run_case(0, "b99a09b681c0da4062f5846cff95f037e04449b363a74683abd695e331c17cfc5c72a50bf68479f6fa4c731b2a7b5bea858e2f7cf931cf8005b9dbf7d7d4c52a", "773e35a4ac0ff9296fb46f3af8c6371dc6eacb43aa2cf8a0d42879083f5e0fac", "1e4e4fd64093866055ef5e0d2b9fdfa3724f95df601993a1dd5374ff95517a168383ff14d0d39cb446a1768a6601e6e2165db81e4cac2e8e9dac6560f38711f9", true)
