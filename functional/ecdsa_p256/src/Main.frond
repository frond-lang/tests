    // malformed sizes throw
    match EcdsaP256.verify([0u8, ..32], [0u8, ..32], [0u8, ..64]) {
        Ok(_) => { failures = failures + 1; println("  FAIL: short pubkey should throw") },
        Error(_) => println("  PASS: malformed input throws"),
    }
    if failures == 0 { println("RESULT: ALL PASSED") } else { println("RESULT: {failures} FAILED") }
