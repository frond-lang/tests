// 功能验证:std.core 根库一次 import 引入全部子库(types 的全部类型命名空间);
// 子库直入形态(import std.core.types)由 str_module 套件锁定
// Str/I8..I128/U8..U128(边界常量+parse)/F16..F64(边界+parse)/F128/Bool。
import std.core

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

// Unwrap a Throw with a fallback (tests only assert the Ok path value).
fun pv<T>(r: Throw<T, ParseError>, fallback: T): T {
    match r {
        Ok(v) => v,
        Err(e) => fallback,
    }
}

fun main(): void {
    // ── 整型边界常量(每模块独立槽:同名 MAX/MIN 不串)──────────
    check(I8.MAX == 127 && I8.MIN == -128, "I8 bounds")
    check(I16.MAX == 32767 && I16.MIN == -32768, "I16 bounds")
    check(I32.MAX == 2147483647 && I32.MIN == -2147483648, "I32 bounds")
    check(I64.MAX == 9223372036854775807 && I64.MIN == -9223372036854775808, "I64 bounds")
    check(U8.MAX == 255, "U8 bounds")
    check(U16.MAX == 65535, "U16 bounds")
    check(U32.MAX == 4294967295, "U32 bounds")
    check(Usize.MAX == 18446744073709551615, "Usize bounds (C UINTPTR_MAX)")
    check(Isize.MAX == 9223372036854775807 && Isize.MIN == -9223372036854775808, "Isize bounds (C INTPTR_MAX/MIN)")
    check(U64.MAX == 18446744073709551615, "U64 bounds")
    check(I128.MAX == 170141183460469231731687303715884105727, "I128 MAX")
    check(I128.MIN == -170141183460469231731687303715884105728, "I128 MIN")
    check(U128.MAX == 340282366920938463463374607431768211455, "U128 bounds")

    // ── 浮点常量 ─────────────────────────────────────────────
    check(F16.MAX == 65504.0, "F16 MAX")
    check(F32.MAX == 3.4028234663852886e38, "F32 MAX")
    check(F64.MAX == 1.7976931348623157e308, "F64 MAX")
    check(F64.MIN == 2.2250738585072014e-308, "F64 MIN (smallest positive normal)")

    // ── 整型 parse（Throw<_, ParseError> 契约）─────────────────
    check(pv(I8.parse("42"), 0) == 42, "I8.parse 42")
    check(pv(I64.parse("-42"), 0) == -42, "I64.parse negative")
    check(pv(U64.parse("18446744073709551615"), 0) == U64.MAX, "U64.parse full range")
    match U8.parse("-1") { Err(e) => check(true, "U8.parse negative errors"), Ok(_) => check(false, "U8.parse negative errors") }
    match U32.parse("-1") { Err(e) => check(true, "U32.parse negative errors"), Ok(_) => check(false, "U32.parse negative errors") }
    match U64.parse("-1") { Err(e) => check(true, "U64.parse negative errors"), Ok(_) => check(false, "U64.parse negative errors") }
    match U128.parse("-1") { Err(e) => check(true, "U128.parse negative errors"), Ok(_) => check(false, "U128.parse negative errors") }
    match Usize.parse("-1") { Err(e) => check(true, "Usize.parse negative errors"), Ok(_) => check(false, "Usize.parse negative errors") }
    check(pv(Isize.parse("-42"), 0) == -42, "Isize.parse negative")
    check(pv(Isize.parse("9223372036854775807"), 0) == Isize.MAX, "Isize.parse MAX via C bounds")
    check(pv(I128.parse("170141183460469231731687303715884105727"), 0) == I128.MAX, "I128.parse MAX")
    match I8.parse("") { Err(e) => check(true, "I8.parse empty errors"), Ok(_) => check(false, "I8.parse empty errors") }
    match I32.parse("12a") { Err(e) => check(true, "I32.parse bad char errors"), Ok(_) => check(false, "I32.parse bad char errors") }
    match I32.parse("-") { Err(e) => check(true, "I32.parse lone sign errors"), Ok(_) => check(false, "I32.parse lone sign errors") }
    match I32.parse("2147483648") { Err(e) => check(true, "I32.parse overflow errors"), Ok(_) => check(false, "I32.parse overflow errors") }

    // ── 浮点 parse（Throw<_, ParseError> 契约）────────────────
    check(pv(F64.parse("3.5"), 0.0) == 3.5, "F64.parse fraction")
    check(pv(F64.parse("3.5e2"), 0.0) == 350.0, "F64.parse exponent")
    check(pv(F64.parse("-0.5"), 0.0) == -0.5, "F64.parse negative fraction")
    check(pv(F32.parse("2.5"), 0.0f32) == 2.5f32, "F32.parse keeps fraction")
    check(pv(F16.parse("1.5"), 0.0f16) == 1.5f16, "F16.parse keeps fraction")
    match F64.parse("1e400") { Err(e) => check(true, "F64.parse overflow errors"), Ok(_) => check(false, "F64.parse overflow errors") }
    check((pv(F64.parse("2.5"), 0.0) as f32?) == null || true, "nullable cast sanity")
    match F32.parse("bad") { Err(e) => check(true, "F32.parse junk errors"), Ok(_) => check(false, "F32.parse junk errors") }
    val nb: f64? = null
    val nb32 = nb as f32?
    match nb32 { null => check(true, "cast null stays null"), _ => check(false, "cast null stays null") }
    match F64.parse("") { Err(e) => check(true, "F64.parse empty errors"), Ok(_) => check(false, "F64.parse empty errors") }
    match F64.parse(".") { Err(e) => check(true, "F64.parse lone dot errors"), Ok(_) => check(false, "F64.parse lone dot errors") }
    match F64.parse("1e") { Err(e) => check(true, "F64.parse dangling exp errors"), Ok(_) => check(false, "F64.parse dangling exp errors") }
    match F64.parse("1e999") { Err(e) => check(true, "F64.parse overflow errors"), Ok(_) => check(false, "F64.parse overflow errors") }

    // ── Bool.parse ───────────────────────────────────────────
    check(Bool.parse("true") == true && Bool.parse("false") == false, "Bool.parse true/false")
    match Bool.parse("yes") { null => check(true, "Bool.parse junk is null"), _ => check(false, "Bool.parse junk is null") }

    // ── Str 命名空间与常量混用(一次 import)──────────────────
    check(Str.repeat("ab", 2) == "abab", "Str.repeat via std.core")

    // ── fmt 子库(std.core 根库一并带出 Fmt)─────────────────
    val h = match Fmt.hex(255) { Ok(s) => s, Err(_) => "" }
    check(h == "ff", "Fmt.hex via std.core")
    check(Fmt.pad_left(h, 4, 48) == "00ff", "Fmt.pad_left via std.core")

    // ── hash 子库(std.core 根库一并带出 Hash/Crc32/Adler32/Xxh64)
    check(Hash.fnv1a("a") == 0xaf63dc4c8601ec8c, "Hash.fnv1a via std.core")
    check(Hash.mix_i64(1) != Hash.mix_i64(2), "Hash.mix_i64 via std.core")
    check(Crc32.crc32("123456789") == (0xCBF43926 as u32), "Crc32.crc32 via std.core")

    summary()
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILURES")
    }
}
