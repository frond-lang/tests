// 功能验证:std.core 根库一次 import 引入全部子库(types 的全部类型命名空间);
// 子库直入形态(import std.core.types)由 str_module 套件锁定
// Str/I8..I128/U8..U128(边界常量+parse)/F16..F64(边界+parse)/F128/Bool。
import std.core

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun main(): void {
    // ── 整型边界常量(每模块独立槽:同名 MAX/MIN 不串)──────────
    check(I8.MAX == 127 && I8.MIN == -128, "I8 bounds")
    check(I16.MAX == 32767 && I16.MIN == -32768, "I16 bounds")
    check(I32.MAX == 2147483647 && I32.MIN == -2147483648, "I32 bounds")
    check(I64.MAX == 9223372036854775807 && I64.MIN == -9223372036854775808, "I64 bounds")
    check(U8.MAX == 255, "U8 bounds")
    check(U16.MAX == 65535, "U16 bounds")
    check(U32.MAX == 4294967295, "U32 bounds")
    check(U64.MAX == 18446744073709551615, "U64 bounds")
    check(I128.MAX == 170141183460469231731687303715884105727, "I128 MAX")
    check(I128.MIN == -170141183460469231731687303715884105728, "I128 MIN")
    check(U128.MAX == 340282366920938463463374607431768211455, "U128 bounds")

    // ── 浮点常量 ─────────────────────────────────────────────
    check(F16.MAX == 65504.0, "F16 MAX")
    check(F32.MAX == 3.4028234663852886e38, "F32 MAX")
    check(F64.MAX == 1.7976931348623157e308, "F64 MAX")
    check(F64.MIN == 2.2250738585072014e-308, "F64 MIN (smallest positive normal)")

    // ── 整型 parse ───────────────────────────────────────────
    check((I8.parse("42") ?? -1) == 42, "I8.parse 42")
    check((I64.parse("-42") ?? 0) == -42, "I64.parse negative")
    check((U64.parse("18446744073709551615") ?? 0) == U64.MAX, "U64.parse full range")
    check(I128.parse("170141183460469231731687303715884105727") == I128.MAX, "I128.parse MAX")
    match I8.parse("") { null => check(true, "I8.parse empty is null"), _ => check(false, "I8.parse empty is null") }
    match I32.parse("12a") { null => check(true, "I32.parse bad char is null"), _ => check(false, "I32.parse bad char is null") }
    match I32.parse("-") { null => check(true, "I32.parse lone sign is null"), _ => check(false, "I32.parse lone sign is null") }

    // ── 浮点 parse ───────────────────────────────────────────
    check(F64.parse("3.5") == 3.5, "F64.parse fraction")
    check(F64.parse("3.5e2") == 350.0, "F64.parse exponent")
    check(F64.parse("-0.5") == -0.5, "F64.parse negative fraction")
    check((F32.parse("2.5") ?? 0) == 2.5, "F32.parse keeps fraction")
    check((F16.parse("1.5") ?? 0) == 1.5, "F16.parse keeps fraction")
    check((F64.parse("2.5") ?? 0) as f32? == null || true, "nullable cast sanity")
    match F32.parse("bad") { null => check(true, "F32.parse junk is null"), _ => check(false, "F32.parse junk is null") }
    val nb: f64? = null
    val nb32 = nb as f32?
    match nb32 { null => check(true, "cast null stays null"), _ => check(false, "cast null stays null") }
    match F64.parse("") { null => check(true, "F64.parse empty is null"), _ => check(false, "F64.parse empty is null") }
    match F64.parse(".") { null => check(true, "F64.parse lone dot is null"), _ => check(false, "F64.parse lone dot is null") }
    match F64.parse("1e") { null => check(true, "F64.parse dangling exp is null"), _ => check(false, "F64.parse dangling exp is null") }
    match F64.parse("1e999") { null => check(true, "F64.parse overflow is null"), _ => check(false, "F64.parse overflow is null") }

    // ── Bool.parse ───────────────────────────────────────────
    check(Bool.parse("true") == true && Bool.parse("false") == false, "Bool.parse true/false")
    match Bool.parse("yes") { null => check(true, "Bool.parse junk is null"), _ => check(false, "Bool.parse junk is null") }

    // ── Str 命名空间与常量混用(一次 import)──────────────────
    check(Str.repeat("ab", 2) == "abab", "Str.repeat via std.core")

    summary()
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILURES")
    }
}
