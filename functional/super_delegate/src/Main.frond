// 功能验证：this/super 统一系统 + override 语义化 + 多 trait 委托消歧
//
// this = 从派发顶端动态找（类型自身 → trait 默认）
// super = 静态指向本类型上该方法绑定的 trait 默认层
// 多 trait 同名冲突在声明点用 `= Trait.m` 绑定解决
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

// ── 1. 默认继承：什么都不声明 → 继承唯一默认 ──
trait Base1 {
    fun tag(): str {
        "base1"
    }
}
type Inh: Base1 = | Inh

// ── 2. override + super：在默认实现之上包装 ──
trait Greeter {
    fun greet(): str {
        "hello"
    }
}
type Wrapper: Greeter = | Wrapper {
    override fun greet(): str {
        "[" + super.greet() + "]"
    }
}

// ── 3. 多 trait 同名默认 → 纯委托消歧（绑定到 A）──
trait A {
    fun m(): str { "A.m" }
}
trait B {
    fun m(): str { "B.m" }
}
type PickA: (A, B) = | PickA {
    fun m(): str = A.m
}

// ── 4. 绑定标注与方法体共存：override 并 super 到指定 trait ──
type PickB: (A, B) = | PickB {
    override fun m(): str = B.m {
        super.m() + "!"
    }
}

// ── 5. super 是层视图，可调用其他方法名（绕过 override 取默认）──
trait Multi {
    fun one(): str { "one" }
    fun two(): str { "two" }
}
type MultiImp: Multi = | MultiImp {
    override fun one(): str {
        super.two() + "+one"
    }
    override fun two(): str {
        "TWO"
    }
}

// ── 6. this 向下穿透：默认方法内调 this.m() 命中 override（模板方法）──
trait Template {
    fun label(): str {
        "tpl:" + render()
    }
    fun render(): str
}
type TplImp: Template = TplImp(body: str) {
    fun render(): str {
        body
    }
}

// ── 7. 冲突下显式 override：一个实现满足两个 trait ──
type OwnM: (A, B) = | OwnM {
    override fun m(): str { "own" }
}

// ── 8. 记录类型 + super ──
type Loud: Greeter = Loud(name: str) {
    override fun greet(): str {
        super.greet() + " " + name
    }
}

// ── trait 继承:trait Pet(Animal) ──
trait Animal2 {
    fun name2(): str { "unnamed" }
    fun speak2(): str
}
trait Pet2(Animal2) {
    fun owner2(): str
    fun intro2(): str { name2() + " (" + owner2() + ")" }
}
type Dog2: (Pet2) = Dog2(n: str, o: str) {
    override fun name2(): str { n }
    fun speak2(): str { "woof" }
    fun owner2(): str { o }
}
// 父默认直接可见(实现类未提供 name2 时)
type Stray2: (Pet2) = Stray2(o: str) {
    fun speak2(): str { "..." }
    fun owner2(): str { o }
}
// 子 trait 覆写遮蔽两父冲突
trait PA { fun pick(): str { "PA" } }
trait PB { fun pick(): str { "PB" } }
trait PC(PA, PB) {
    fun pick(): str { "PC" }
}
type Picker: (PC) = Picker(v: i32) { }
// 子 trait 默认内 super → 父默认
trait Shout(Animal2) {
    fun shout(): str { name2() + "!!" }
}
type Cat2: (Shout) = Cat2(n: str) {
    override fun name2(): str { n }
    fun speak2(): str { "meow" }
    fun owner2(): str { "none" }
}
fun via_animal(a: Animal2): str { a.speak2() }

fun trait_inheritance(): void {
    println("-- trait inheritance --")
    val d = Dog2("rex", "ann")
    check(d.intro2() == "rex (ann)", "parent methods visible on child impl")
    check(d.speak2() == "woof", "parent abstract implemented")
    val stray = Stray2("bob")
    check(stray.name2() == "unnamed", "parent default inherited when not overridden")
    check(stray.intro2() == "unnamed (bob)", "child default uses parent default")
    val pk = Picker(1)
    check(pk.pick() == "PC", "child trait declaration shadows conflicting parents")
    val c = Cat2("tom")
    check(c.shout() == "tom!!", "child default calls parent default")
    check(via_animal(c) == "meow", "child-trait value flows into parent-trait param")
}

fun main(): void {
    trait_inheritance()
    println("=== super / delegate / override ===")

    check(Inh.tag() == "base1", "default inherited without declaration")

    check(Wrapper.greet() == "[hello]", "override wraps default via super")

    check(PickA.m() == "A.m", "delegate resolves conflict to A")
    check(PickB.m() == "B.m!", "binding annotation + body + super")

    check(MultiImp.one() == "two+one", "super calls sibling method default")
    check(MultiImp.two() == "TWO", "own override wins normal dispatch")

    check(TplImp("R").label() == "tpl:R", "default dispatches down to override via this")

    check(OwnM.m() == "own", "explicit override satisfies both traits")

    check(Loud("frond").greet() == "hello frond", "record type super call")

    summary()
}
