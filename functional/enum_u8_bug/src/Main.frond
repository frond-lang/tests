// 测试 u8 相等比较
fun main(): void {
    val b: u8 = 0x62u8  // 'b' = 98

    // 直接比较
    println("b=" + b as str)
    println("b == 0x62: " + (b == 0x62u8) as str)
    println("b == 0x61: " + (b == 0x61u8) as str)
    println("b == 0x09: " + (b == 0x09u8) as str)
    println("b == 98: " + (b == 98u8) as str)
    println("b == 9: " + (b == 9u8) as str)

    // 测试 match
    match b {
        0x61u8 => println("matched 0x61"),
        0x62u8 => println("matched 0x62 (correct)"),
        0x09u8 => println("matched 0x09 (BUG!)"),
        _ => println("matched default")
    }

    // 用十进制字面量
    match b {
        97u8 => println("dec: matched 97"),
        98u8 => println("dec: matched 98 (correct)"),
        9u8 => println("dec: matched 9 (BUG!)"),
        _ => println("dec: matched default")
    }

    // 测试其他值
    val t: u8 = 0x09u8  // tab = 9
    println("")
    println("t=" + t as str)
    match t {
        0x62u8 => println("t matched 0x62 (BUG!)"),
        0x09u8 => println("t matched 0x09 (correct)"),
        _ => println("t matched default")
    }

    // 转正断言(2026-08-18):u8 相等/字面量 match 全部按值路由
    val ok = b == 0x62u8 && b != 0x61u8 && b != 0x09u8 && b == 98u8 && b != 9u8 && t == 0x09u8 && t != 0x62u8
    if ok {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: 1 FAILED")
    }
}
