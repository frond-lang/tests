// ecdsa_p384 - ECDSA P-384 verification kernel acceptance.
// Vectors from the Python cryptography library (real signatures over
// random messages, SHA-384); every other case tampers the digest.
import std.crypto.EcdsaP384

var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun hex_bytes(s: str): u8[] {
    match std.encoding.Hex.decode(s) {
        null => [],
        b => b,
    }
}

fun run_case(idx: i32, pub_hex: str, hash_hex: str, rs_hex: str, expect: bool): void {
    val pk = hex_bytes(pub_hex)
    val h = hex_bytes(hash_hex)
    val rs = hex_bytes(rs_hex)
    val got = match EcdsaP384.verify(pk, h, rs) {
        Ok(v) => v,
        Error(e) => { println("  error: {e.message}"); false },
    }
    if got == expect {
        println("  PASS: vector {idx} (expect {expect})")
    } else {
        failures = failures + 1
        println("  FAIL: vector {idx} (expected {expect}, got {got})")
    }
}

