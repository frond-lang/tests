// EXPECT-EXIT 73
// 切片 6b:monomorph——同泛型函数多实例(idt<i64> 与 idt<str> 双实例,
// 共享体 expr 键的末者胜问题由此考验)+ 泛型数组参数。
// 42+4+11+8+8=73(ksize=4+4)。
import Gen.{idt, pick, ksize}

fun main(): i32 {
    val a = idt(42)
    val s = idt("xyzw")
    val p1 = pick(true, 11, 22)
    val p2 = pick(false, 3, 8)
    val k = ksize([1, 2, 3, 4], 4)
    (a + s.len() as i64 + p1 + p2 + k) as i32
}
