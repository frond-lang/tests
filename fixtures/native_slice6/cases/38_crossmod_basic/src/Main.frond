// EXPECT-EXIT 81
// 切片 6a:跨模块基础——选择性导入的裸调用 + 跨模块 record 构造/
// 字段读 + 跨模块 ADT ctor/match。42+30+7+2=81。
import Helper.{dbl, pick, sum_p, P, Color, Red, Green, Blue}

fun main(): i32 {
    val d = dbl(21)
    val m = pick(10, 30)
    val p = P(3, 4)
    val s = sum_p(p)
    val c: Color = Green
    val cv = match c {
        Red => 1
        Green => 2
        Blue => 3
        _ => 0
    }
    (d + m + s + cv) as i32
}
