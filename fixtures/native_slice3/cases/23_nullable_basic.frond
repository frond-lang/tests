// EXPECT-EXIT 60
// 切片 3:nullable T?——box(标量→T?)/unbox(流窄化)/判空(== null)/
// elvis(??)/null 字面量/null 模式 + PVar 绑定窄化。
// n1=7, n2=elvis(null)=5, e 判空走窄化 +1=8, arr[1]=null→elvis 3,
// m 里 null 计 1;合计 7+5+8+3+1+36(基线)= 60。
fun countNull(a: i32?[]): i64 {
    var n: i64 = 0
    var i: usize = 0
    while i < a.len() {
        if a[i] == null {
            n = n + 1
        }
        i = i + 1
    }
    n
}

fun main(): i32 {
    val n1: i64? = 7
    val v1 = n1 ?? 5
    val n2: i64? = null
    val v2 = n2 ?? 5
    val e: i64? = n1
    var v3: i64 = 0
    if e != null {
        v3 = e + 1
    }
    val arr: i32?[] = [1, null, 3]
    val v4 = arr[1] ?? 3
    val m = countNull(arr)
    val base = 36
    (v1 + v2 + v3 + m + base + (v4 as i64)) as i32
}
