// EXPECT-EXIT 70
// 切片 5:嵌套动态组合——str 数组拼接后取码点、record 装数组深相等、
// 拼接链、切片的切片。
// cps=A+C+D=200;m2="bc" len2;嵌套数组 eq true;链 len5;
// 200+2+5+8-145=70。
type Box = Box(items: i64[])

fun main(): i32 {
    val strs = ["AB", "C"]
    val all = strs ++ ["D"]
    var cps: i64 = 0
    var i: usize = 0
    while i < all.len() {
        cps = cps + all[i][0] as i64
        i = i + 1
    }
    val u = "abcd"
    val m = u[1..3]
    val m2 = m[0..2]
    val b1 = Box([7, 8, 9])
    val b2 = Box([7, 8, 9])
    val nested_eq = b1 == b2
    val chain = [1] ++ [2] ++ [3, 4, 5]
    var acc: i64 = cps + m2.len() as i64 + chain.len() as i64
    if nested_eq { acc = acc + 8 }
    (acc - 145) as i32
}
